// Shared by every target and configuration.
#include "Brand.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
CLANG_ENABLE_MODULES = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO
ENABLE_PREVIEWS = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic

// D3: Debug appends .dev so the real ID is never registered on the free personal team (C10).
SEVENS_BUNDLE_ID = $(SEVENS_BUNDLE_ID_BASE)$(SEVENS_BUNDLE_ID_SUFFIX)
SEVENS_APP_GROUP = group.$(SEVENS_BUNDLE_ID)

// C8: set to NO (and drop Hotspot from the entitlements) if free signing refuses it.
WIFI_JOIN_AVAILABLE = YES

// DEVELOPMENT_TEAM and other machine-local settings; not committed.
#include? "Local.xcconfig"
