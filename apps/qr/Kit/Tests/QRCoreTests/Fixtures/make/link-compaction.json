[
  { "id": "make-plain-host", "note": "plain host, no path", "input": "https://example.com",
    "trimmed": "https://example.com", "compacted": "HTTPS://EXAMPLE.COM", "gains": true },
  { "id": "make-lone-slash", "note": "a lone trailing slash goes", "input": "https://example.com/",
    "trimmed": "https://example.com", "compacted": "HTTPS://EXAMPLE.COM", "gains": true },
  { "id": "make-mixed-case-host", "note": "host written in mixed case", "input": "HtTpS://ExAmPlE.CoM/",
    "trimmed": "HtTpS://ExAmPlE.CoM", "compacted": "HTTPS://EXAMPLE.COM", "gains": true },
  { "id": "make-path-kept", "note": "mixed-case path is kept byte for byte", "input": "https://example.com/Menu/Today",
    "trimmed": "https://example.com/Menu/Today", "compacted": "HTTPS://EXAMPLE.COM/Menu/Today", "gains": true },
  { "id": "make-query-kept", "note": "mixed-case query is kept", "input": "http://example.com/?Name=Ana&x=Y",
    "trimmed": "http://example.com/?Name=Ana&x=Y", "compacted": "HTTP://EXAMPLE.COM/?Name=Ana&x=Y", "gains": true },
  { "id": "make-fragment-kept", "note": "fragment is kept", "input": "https://example.com/a#Top",
    "trimmed": "https://example.com/a#Top", "compacted": "HTTPS://EXAMPLE.COM/a#Top", "gains": true },
  { "id": "make-lone-slash-with-fragment", "note": "slash before a fragment is not trailing", "input": "https://example.com/#x",
    "trimmed": "https://example.com/#x", "compacted": "HTTPS://EXAMPLE.COM/#x", "gains": true },
  { "id": "make-lone-slash-with-query", "note": "slash before a query stays", "input": "https://example.com/?q=1",
    "trimmed": "https://example.com/?q=1", "compacted": "HTTPS://EXAMPLE.COM/?q=1", "gains": true },
  { "id": "make-path-slash-stays", "note": "a trailing slash after a path stays", "input": "https://example.com/menu/",
    "trimmed": "https://example.com/menu/", "compacted": "HTTPS://EXAMPLE.COM/menu/", "gains": true },
  { "id": "make-https-default-port", "note": ":443 on https goes", "input": "https://example.com:443/a",
    "trimmed": "https://example.com/a", "compacted": "HTTPS://EXAMPLE.COM/a", "gains": true },
  { "id": "make-http-default-port", "note": ":80 on http goes", "input": "http://example.com:80/",
    "trimmed": "http://example.com", "compacted": "HTTP://EXAMPLE.COM", "gains": true },
  { "id": "make-wrong-default-port", "note": ":80 on https is not a default and stays", "input": "https://example.com:80/a",
    "trimmed": "https://example.com:80/a", "compacted": "HTTPS://EXAMPLE.COM:80/a", "gains": true },
  { "id": "make-other-port", "note": "a real port stays", "input": "https://example.com:8443/a",
    "trimmed": "https://example.com:8443/a", "compacted": "HTTPS://EXAMPLE.COM:8443/a", "gains": true },
  { "id": "make-idn-host", "note": "Unicode host becomes its xn-- form, uppercased", "input": "https://bücher.example/Buch",
    "trimmed": "https://bücher.example/Buch", "compacted": "HTTPS://XN--BCHER-KVA.EXAMPLE/Buch", "gains": true },
  { "id": "make-idn-host-mixed-case", "note": "Unicode host in capitals", "input": "https://BÜCHER.example",
    "trimmed": "https://BÜCHER.example", "compacted": "HTTPS://XN--BCHER-KVA.EXAMPLE", "gains": true },
  { "id": "make-ipv6-host", "note": "IPv6 hex uppercased; the brackets keep the code in byte mode", "input": "http://[2001:db8::ab]/x",
    "trimmed": "http://[2001:db8::ab]/x", "compacted": "HTTP://[2001:DB8::AB]/x", "gains": false },
  { "id": "make-ipv6-port", "note": "IPv6 with a non-default port", "input": "https://[::1]:8443",
    "trimmed": "https://[::1]:8443", "compacted": "HTTPS://[::1]:8443", "gains": false },
  { "id": "make-ipv6-default-port", "note": "IPv6 with the default port", "input": "https://[2001:db8::1]:443/",
    "trimmed": "https://[2001:db8::1]", "compacted": "HTTPS://[2001:DB8::1]", "gains": false },
  { "id": "make-ipv4-host", "note": "dotted IPv4 host", "input": "http://192.168.0.1/Admin",
    "trimmed": "http://192.168.0.1/Admin", "compacted": "HTTP://192.168.0.1/Admin", "gains": true },
  { "id": "make-userinfo", "note": "userinfo is never touched", "input": "https://Bank.com@Evil.example/Login",
    "trimmed": "https://Bank.com@Evil.example/Login", "compacted": "HTTPS://Bank.com@EVIL.EXAMPLE/Login", "gains": true },
  { "id": "make-userinfo-password-port", "note": "user:password and a default port", "input": "http://User:Pw@example.com:80/",
    "trimmed": "http://User:Pw@example.com", "compacted": "HTTP://User:Pw@EXAMPLE.COM", "gains": true },
  { "id": "make-lowercase-path-gains-nothing", "note": "a long lowercase path: the symbol stays in byte mode, nothing gained",
    "input": "https://example.com/some/long/lowercase/path/that/goes/on?and=on&on=and",
    "trimmed": "https://example.com/some/long/lowercase/path/that/goes/on?and=on&on=and",
    "compacted": "HTTPS://EXAMPLE.COM/some/long/lowercase/path/that/goes/on?and=on&on=and", "gains": false },
  { "id": "make-already-capitals", "note": "already in capitals: unchanged", "input": "HTTPS://EXAMPLE.COM",
    "trimmed": "HTTPS://EXAMPLE.COM", "compacted": "HTTPS://EXAMPLE.COM", "gains": false },
  { "id": "make-www-kept", "note": "www. is never removed", "input": "https://www.example.com/",
    "trimmed": "https://www.example.com", "compacted": "HTTPS://WWW.EXAMPLE.COM", "gains": true },
  { "id": "make-http-stays-http", "note": "http is never upgraded", "input": "http://example.com/a",
    "trimmed": "http://example.com/a", "compacted": "HTTP://EXAMPLE.COM/a", "gains": true },
  { "id": "make-not-a-link-mailto", "note": "other schemes are left alone", "input": "mailto:a@example.com",
    "trimmed": "mailto:a@example.com", "compacted": null, "gains": false },
  { "id": "make-not-a-link-text", "note": "plain text", "input": "hello world",
    "trimmed": "hello world", "compacted": null, "gains": false },
  { "id": "make-schemeless", "note": "no scheme: Make does not guess one", "input": "example.com/a",
    "trimmed": "example.com/a", "compacted": null, "gains": false }
]
