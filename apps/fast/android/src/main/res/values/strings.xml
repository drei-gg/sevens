    <string name="settings_network_exports">Exports go only to the destination you choose.</string>
    <string name="delete_all_title">Delete every fast, journal entry, measurement, plan and rest day?</string>
    <string name="delete_all_message">This also ends any running timer and removes custom presets. Your preferences stay. Export a backup first if you want to keep a copy. This can’t be undone.</string>
    <string name="delete_all_done">All records deleted. Preferences were kept.</string>

