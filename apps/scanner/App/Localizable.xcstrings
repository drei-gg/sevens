      "comment": "Scanner count. %lld is the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not every page fit in this document (50 pages and 100 MB of images at most), so the last %lld page you scanned was saved as a new document."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not every page fit in this document (50 pages and 100 MB of images at most), so the last %lld pages you scanned were saved as a new document."
                }
              }
            }
          }
        }
      }
    },
    "scanner.count.overflowDocuments": {
      "comment": "Scanner count. %lld is the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not every page fit in this document (50 pages and 100 MB of images at most), so the rest were saved as %lld new document."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Not every page fit in this document (50 pages and 100 MB of images at most), so the rest were saved as %lld new documents."
                }
              }
            }
          }
        }
      }
    },
    "scanner.count.split": {
      "comment": "Scanner count. %lld is the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A document holds 50 pages and 100 MB of images at most, so this scan was saved as %lld document."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A document holds 50 pages and 100 MB of images at most, so this scan was saved as %lld documents."
                }
              }
            }
          }
        }
      }
    },
    "scanner.count.unreadable": {
      "comment": "Scanner count. %lld is the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld document folder could not be read. Its files have been preserved. Backup is paused until it can be recovered."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld document folders could not be read. Their files have been preserved. Backup is paused until they can be recovered."
                }
              }
            }
          }
        }
      }
    },
    "scanner.count.unsaved": {
      "comment": "Scanner count. %lld is the number.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld scanned page couldn’t be saved. It is kept until you try again or discard it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld scanned pages couldn’t be saved. They are kept until you try again or discard them."
                }
              }
            }
          }
        }
      }
    }
