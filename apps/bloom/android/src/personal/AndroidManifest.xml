<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name="gg.seven.bloom.bridge.BloomWearListenerService" android:exported="true" tools:ignore="ExportedService">
            <intent-filter><action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" /><data android:scheme="wear" android:host="*" android:pathPrefix="/bloom/request" /></intent-filter>
        </service>
        <provider android:name="androidx.startup.InitializationProvider" android:authorities="${applicationId}.androidx-startup" android:exported="false" tools:node="merge">
            <meta-data android:name="gg.seven.bloom.bridge.WearBridgeInitializer" android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
