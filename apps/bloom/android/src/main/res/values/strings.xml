    <string name="guides_title">Guides and sources</string>
    <string name="guides_records">Know your records</string>
    <string name="guides_cycle_day">Cycle day starts with the first day of a period. Log a new period start when needed; spotting is recorded separately. Missing days are unknown, not symptom-free days.</string>
    <string name="guides_estimates">Your estimates use recent logged cycles. Variable cycles, hormonal contraception and life-stage changes make calendar predictions less useful. No date in this app can establish contraceptive protection.</string>
    <string name="guides_reports">Use symptom and dose reports to prepare for a conversation with a clinician. This app does not assess PCOS, endometriosis, pregnancy health or menopause.</string>
