        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local report with app and OS versions, alarm permission, registration counts and error flags. Leaves out names, schedules, scanned codes, phrases and history. Nothing is sent automatically. Registration counts don’t prove an alarm rang."
          }
        }
      }
    },
