    "Import %lld routines and %lld history records? Existing routine IDs are kept; new routines start turned off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import %#@routines@ and %#@records@? Existing routine IDs are kept; new routines start turned off."
          },
          "substitutions": {
            "routines": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg routine"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg routines"
                    }
                  }
                }
              }
            },
            "records": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg history record"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg history records"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
