<?xml version="1.0" encoding="utf-8"?>
<!-- Imported sounds (AlarmLoops/Sounds, up to 128 MiB) stay out: they would exceed Auto Backup's
     25 MB quota and fail the whole backup. Saved selections fall back to their built-in tone. -->
<data-extraction-rules><cloud-backup><include domain="sharedpref" path="seven-trial.xml"/><include domain="device_file" path="AlarmLoops/"/><exclude domain="device_file" path="AlarmLoops/Sounds/"/></cloud-backup><device-transfer><include domain="sharedpref" path="seven-trial.xml"/><include domain="device_file" path="AlarmLoops/"/><exclude domain="device_file" path="AlarmLoops/Sounds/"/></device-transfer></data-extraction-rules>
