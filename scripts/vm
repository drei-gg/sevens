#!/usr/bin/env bash
# Run an Apple build in the macOS VM (ssh tahoe), one at a time.
# usage: scripts/vm <version|build|test|test-kit|ui|device|sh> [args...]
#   version        xcodebuild -version (lock check)
#   build          app, Debug, simulator
#   test           all unit tests on the simulator (no UI smoke test)
#   test-kit       QRKit and SevenKit package tests only (simulator)
#   ui [--device]  the UI tests (simulator, or the iPhone), without the screenshot tour
#   screens        the screenshot tour (ScreensTourTests: every screen, light and dark); the result
#                  bundle path is in the log, see scripts/export-screens
#   device         build, sign and install on the iPhone (runs in the guest's GUI session)
#   lock-device    lock the iPhone (run last; nothing can unlock it remotely)
#   sh CMD...      run a command in the synced checkout
# env: SEVENS_APP (an app under apps/ with a case below; defaults to qr)
#      VM_SLOT (default: worktree folder name, "main" for the main checkout)
#      VM_VERBOSE=1 streams the whole log; otherwise errors, warnings and the tail.
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cmd=${1:-}; [ $# -gt 0 ] && shift
app=${SEVENS_APP:-qr}
case "$app" in qr) scheme=QR;; scanner) scheme=Scanner;; *) echo "Unknown app: $app" >&2; exit 2;; esac
if [ "$app" != qr ] && [[ "$cmd" = device || "$cmd" = lock-device || ( "$cmd" = ui && "${1:-}" = --device ) ]]; then
  echo "vm: device signing for $app is not configured yet" >&2; exit 2
fi
base=$(basename "$root"); [ "$base" = sevens ] && base=main
slot=${VM_SLOT:-$base}
[ "$app" = qr ] || slot="$slot-$app"
remote="src/sevens-$slot"
dd="\$HOME/src/dd-$slot"
logdir="$HOME/.cache/sevens/logs"; mkdir -p "$logdir"
log="$logdir/$slot-$cmd.log"

exec 9>"$HOME/.cache/sevens/vm.lock"
if ! flock -n 9; then echo "vm: waiting for the lock (another build is running)…" >&2; flock 9; fi

ssh -o BatchMode=yes -o ConnectTimeout=10 tahoe true || { echo "vm: tahoe is not reachable" >&2; exit 3; }

# Standing rule (Drei, 10 Nov 2026, corrected): one shared simulator. Boot it only when work
# needs it, keep it up while work continues; a guest timer shuts it down after 15 idle minutes.
# Commands that run an app or tests on it first call the guest's ~/bin/sim-ensure --wait and
# take its UDID from sim-ensure --print (VM_SIM_UDID overrides). Builds and tests use the shared simulator UDID. Scripts never shut down, erase or
# delete it, and tests never clone it (-parallel-testing-enabled NO). Need a clean app state?
# Uninstall the app instead.
case "$cmd" in
  build|test|test-kit|ui|screens)
    if [ "$cmd" = ui ] && [ "${1:-}" = --device ]; then :; else
      ssh tahoe '~/bin/sim-ensure --wait' >/dev/null || { echo "vm: simulator not ready (sim-ensure --wait failed)" >&2; exit 3; }
      sim=${VM_SIM_UDID:-$(ssh tahoe '~/bin/sim-ensure --print')}
      [ -n "$sim" ] || { echo "vm: sim-ensure gave no simulator UDID" >&2; exit 3; }
      dest="platform=iOS Simulator,id=$sim"
    fi;;
esac
noclone="-parallel-testing-enabled NO"

sync_tree() {
  ssh tahoe "mkdir -p $remote"
  rsync -a --delete --exclude .git --exclude .build --exclude DerivedData \
    --exclude 'xcuserdata/' "$root/" "tahoe:$remote/"
}

strictw="SWIFT_SUPPRESS_WARNINGS=NO SWIFT_TREAT_WARNINGS_AS_ERRORS=YES"
xb="xcodebuild -project apps/$app/$scheme.xcodeproj -scheme $scheme -derivedDataPath $dd $strictw"
case "$cmd" in
  version) remote_cmd="xcodebuild -version";;
  build)   remote_cmd="$xb -configuration Debug -destination '$dest' build";;
  test)    if [ "$app" = scanner ]; then
             remote_cmd="cd apps/scanner/Kit && xcodebuild -scheme ScannerKit -derivedDataPath $dd $strictw -destination '$dest' $noclone test"
           else
             remote_cmd="$xb -configuration Debug -destination '$dest' -skip-testing:${scheme}SmokeUITests $noclone test"
           fi;;
  test-kit) remote_cmd="set -o pipefail; (cd SevenKit && xcodebuild -scheme SevenKit-Package -derivedDataPath $dd-sevenkit $strictw -destination '$dest' $noclone test) && (cd apps/$app/Kit && xcodebuild -scheme ${scheme}Kit-Package -derivedDataPath $dd-${app}kit $strictw -destination '$dest' $noclone test)";;
  ui)
    if [ "${1:-}" = --device ]; then
      remote_cmd="bash scripts/guest-device.sh '$dd' test -only-testing:${scheme}SmokeUITests -skip-testing:${scheme}SmokeUITests/LockDeviceTests -skip-testing:${scheme}SmokeUITests/ScreensTourTests"
    else
      remote_cmd="$xb -configuration Debug -destination '$dest' -only-testing:${scheme}SmokeUITests -skip-testing:${scheme}SmokeUITests/LockDeviceTests -skip-testing:${scheme}SmokeUITests/ScreensTourTests $noclone test"
    fi;;
  screens)
    remote_cmd="rm -rf \$HOME/src/screens-$slot.xcresult; $xb -configuration Debug -destination '$dest' -only-testing:${scheme}SmokeUITests/ScreensTourTests -resultBundlePath \$HOME/src/screens-$slot.xcresult $noclone test";;
  lock-device)
    # The very last device step: lock the iPhone (UI-test target only; see LockDeviceTests).
    remote_cmd="bash scripts/guest-device.sh '$dd' test -only-testing:${scheme}SmokeUITests/LockDeviceTests";;
  device)
    # Signing needs the GUI session's keychain (runbook: signing over SSH fails),
    # so the build runs in Terminal.app and we follow its log.
    remote_cmd="bash scripts/guest-device.sh '$dd' install";;
  sh) remote_cmd="$*";;
  *) sed -n '2,14p' "$0"; exit 2;;
esac

if [ "$cmd" = version ]; then remote="."; else sync_tree; fi
echo "vm[$slot] $cmd → $log" >&2
set +e
ssh tahoe "cd $remote && $remote_cmd" >"$log" 2>&1 &
pid=$!
if [ "${VM_VERBOSE:-0}" = 1 ]; then tail -n +1 -f --pid=$pid "$log"; fi
wait $pid; status=$?
set -e
if [ "${VM_VERBOSE:-0}" != 1 ]; then
  grep -E '(error|warning): |\*\* [A-Z -]+ (SUCCEEDED|FAILED) \*\*|^Test (Suite|Case).*(failed|passed)|✘|Testing failed|Executed [0-9]+ test|Test run with [0-9]+ tests' "$log" \
    | grep -vE 'appintentsmetadataprocessor' | sort -u | head -n 150 || true
  echo "----- tail -----"; tail -n 25 "$log"
fi
w=$( (grep -E '(^|: )warning: ' "$log" || true) | (grep -vE 'appintentsmetadataprocessor' || true) | sort -u | wc -l)
echo "vm[$slot] $cmd: exit $status, warnings $w (full log: $log)"
exit $status
