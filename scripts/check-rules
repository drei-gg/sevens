#!/usr/bin/env bash
# Gates G6 (network, no data-collecting SDKs, pinned and credited dependencies) and G7 ("safe", hard-coded prices).
# usage: scripts/check-rules        exits non-zero on any violation
set -uo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
fail=0
bad() { echo "FAIL $1"; shift; printf '  %s\n' "$@"; fail=1; }

swift_files() { git ls-files --cached --others --exclude-standard -- '*.swift' | grep -v '/\.build/' ; }

# G6a: network APIs only in PeekClient, ListsUpdater (and their tests) and SevenKit's StoreKit layer.
hits=$(swift_files | grep -vE '^apps/qr/Kit/Sources/QRUI/Peek/PeekClient\.swift$|^apps/qr/Kit/Sources/QRUI/Lists/ListsUpdater\.swift$|^apps/qr/Kit/Tests/QRUITests/(Peek|Lists)[^/]*\.swift$|^SevenKit/Sources/SevenKit/' \
  | xargs -r grep -nE '\b(URLSession|NWConnection|URLRequest|FoundationNetworking|CFNetwork|NSURLConnection)\b' || true)
[ -z "$hits" ] || bad "G6 network API outside PeekClient/ListsUpdater/SevenKit:" "$hits"
# SevenKit may use StoreKit, but not raw networking either.
hits=$(swift_files | grep -E '^SevenKit/Sources/' | xargs -r grep -nE '\b(URLSession|NWConnection|URLRequest)\b' || true)
[ -z "$hits" ] || bad "G6 raw network API in SevenKit:" "$hits"

# G6b: no SDK that collects anything (analytics, ads, crash reporting, push, telemetry).
deny='Firebase[A-Za-z]*|GoogleAnalytics|GoogleMobileAds|Crashlytics|Sentry[A-Za-z]*|Bugsnag[A-Za-z]*|Amplitude[A-Za-z]*|Mixpanel|AppsFlyer[A-Za-z]*|Adjust[A-Za-z]*|Segment[A-Za-z]*|FBSDK[A-Za-z]*|FBAudienceNetwork|AdMob|AppLovin[A-Za-z]*|OneSignal[A-Za-z]*|Datadog[A-Za-z]*|NewRelic[A-Za-z]*'
hits=$(swift_files | xargs -r grep -nE "^\s*(@[A-Za-z_]+(\([A-Za-z]+\))?\s+)*import\s+(class |struct |enum |func |protocol )?($deny)\b" || true)
hits+=$(git ls-files --cached --others --exclude-standard -- '*Package.swift' '*.pbxproj' '*Package.resolved' | xargs -r grep -niE "($deny)" | grep -viE 'firebase-free|no-analytics' || true)
[ -z "$hits" ] || bad "G6 data-collecting SDK (deny-list):" "$hits"
# Pure targets import Foundation (and their own siblings) only.
hits=$(swift_files | grep -E '^(apps/qr/Kit/Sources/QRCore|SevenKit/Sources/SevenKitCore)/' \
  | xargs -r grep -nE '^\s*(@[a-zA-Z]+\s+)*import\s' | grep -vE 'import\s+(Foundation|QRCore|SevenKitCore)\s*$' || true)
[ -z "$hits" ] || bad "G6 pure target imports something other than Foundation:" "$hits"

# G6c: open-source libraries are welcome, but every one is pinned and credited in THIRD-PARTY.md
# with an allowed licence. Local path packages (SevenKit, QRKit) are ours and exempt.
licences='MIT|BSD-2-Clause|BSD-3-Clause|Apache-2\.0|MPL-2\.0|ISC|Zlib|Unicode|GPL-3\.0|LGPL-3\.0|GPL-3\.0-compatible'
deps=$(git ls-files --cached --others --exclude-standard -- '*Package.swift' | xargs -r grep -noE '\.package\(\s*(name:[^,]*,\s*)?url:[^)]*\)?' || true)
unpinned=$(printf '%s\n' "$deps" | grep -vE '(exact:|revision:|\.exact\(|\.revision\()' | grep -v '^$' || true)
[ -z "$unpinned" ] || bad "G6 package dependency not pinned to an exact version or revision:" "$unpinned"
pbx=$(git ls-files --cached --others --exclude-standard -- '*.pbxproj' || true)
if [ -n "$pbx" ] && grep -q 'XCRemoteSwiftPackageReference' $pbx; then
  hits=$(grep -nA4 'requirement = {' $pbx | grep -nE 'kind = ' | grep -vE 'kind = (exactVersion|revision);' || true)
  [ -z "$hits" ] || bad "G6 Xcode package not pinned to an exact version or revision:" "$hits"
  deps+=$'\n'$(grep -nE 'repositoryURL = ' $pbx || true)
fi
for url in $(printf '%s\n' "$deps" | grep -oE 'https?://[^"]+' | sed -E 's/\.git$//' | sort -u); do
  line=$(grep -F "$url" THIRD-PARTY.md 2>/dev/null | head -1)
  if [ -z "$line" ]; then bad "G6 dependency missing from THIRD-PARTY.md:" "$url"
  elif ! printf '%s' "$line" | grep -qE "\b($licences)\b"; then bad "G6 dependency licence not on the allowed list (THIRD-PARTY.md):" "$line"
  fi
done

# G7: user-facing text. String catalogs, plists and string literals in UI code.
ui_swift=$(swift_files | grep -E '^(apps/qr/Kit/Sources/QRUI|SevenKit/Sources/SevenKit|apps/qr/App|apps/qr/MakeExtension|apps/qr/CheckExtension)/' || true)
ui_text=$(git ls-files --cached --others --exclude-standard -- '*.xcstrings' '*.strings' 'apps/qr/*Info.plist' 'apps/qr/**/Info.plist' 'apps/qr/Config/*.plist' || true)
hits=$( { [ -z "$ui_swift" ] || echo "$ui_swift" | xargs grep -nP '"(?:[^"\\]|\\.)*\bsafe(ly|ty|r|st)?\b(?:[^"\\]|\\.)*"' -i; \
          [ -z "$ui_text" ] || echo "$ui_text" | xargs grep -nPi '\bsafe(ly|ty|r|st)?\b'; } 2>/dev/null || true)
[ -z "$hits" ] || bad "G7 the word \"safe\" in user-facing text:" "$hits"
# Hard-coded prices: $7, $7.00, "seven dollars", 7 USD… The $7&D mark is a name, not a price.
hits=$( { [ -z "$ui_swift" ] || echo "$ui_swift" | xargs grep -nP '"(?:[^"\\]|\\.)*(\$\s?\d+(?!&)|\d+[.,]\d\d\s?(USD|EUR|€)|seven dollars)(?:[^"\\]|\\.)*"' -i; \
          [ -z "$ui_text" ] || echo "$ui_text" | xargs grep -nPi '\$\s?\d+(?!&)|seven dollars'; } 2>/dev/null || true)
[ -z "$hits" ] || bad "G7 hard-coded price in user-facing text:" "$hits"

# Internal process documents (plans, build reports, reviews) never get tracked; they live in the private brand repo.
hits=$(git ls-files | grep -E '(^|/)(PLAN(-.*)?|BUILD-REPORT.*|REVIEW.*)\.md$' || true)
[ -z "$hits" ] || bad "internal process document tracked (move it to the private brand repo):" "$hits"

# ...and nothing tracked points at them by name (upstream data files are exempt).
hits=$(git grep -nwE 'PLAN|BUILD-REPORT|REVIEW' -- ':!.gitignore' ':!scripts/check-rules' ':!apps/qr/Kit/Sources/QRCore/Data/public_suffix_list.dat' || true)
[ -z "$hits" ] || bad "tracked file refers to an internal process document:" "$hits"

[ $fail = 0 ] && echo "check-rules: G6 and G7 pass"
exit $fail
