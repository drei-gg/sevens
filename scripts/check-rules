#!/usr/bin/env bash
# Gates G6 (network, no data-collecting SDKs, pinned and credited dependencies) and G7 ("safe", hard-coded prices).
# usage: scripts/check-rules        exits non-zero on any violation
set -uo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
fail=0
bad() { echo "FAIL $1"; shift; printf '  %s\n' "$@"; fail=1; }

swift_files() { git ls-files --cached --others --exclude-standard -- '*.swift' | grep -v '/\.build/' ; }

# G6a: network APIs only in PeekClient, ListsUpdater (and their tests) and SevenKit's StoreKit layer.
hits=$(swift_files | grep -vE '^apps/qr/Kit/Sources/QRUI/Peek/PeekClient\.swift$|^apps/qr/Kit/Sources/QRUI/Lists/ListsUpdater\.swift$|^apps/qr/Kit/Tests/QRUITests/(Peek|Lists)[^/]*\.swift$|^SevenKit/Sources/SevenKit/' \
  | xargs -r grep -nE '\b(URLSession|NWConnection|URLRequest|FoundationNetworking|CFNetwork|NSURLConnection)\b' || true)
[ -z "$hits" ] || bad "G6 network API outside PeekClient/ListsUpdater/SevenKit:" "$hits"
# SevenKit may use StoreKit, but not raw networking either.
hits=$(swift_files | grep -E '^SevenKit/Sources/' | xargs -r grep -nE '\b(URLSession|NWConnection|URLRequest)\b' || true)
[ -z "$hits" ] || bad "G6 raw network API in SevenKit:" "$hits"

# G6b: no SDK that collects anything (analytics, ads, crash reporting, push, telemetry).
deny='Firebase[A-Za-z]*|GoogleAnalytics|GoogleMobileAds|Crashlytics|Sentry[A-Za-z]*|Bugsnag[A-Za-z]*|Amplitude[A-Za-z]*|Mixpanel|AppsFlyer[A-Za-z]*|Adjust[A-Za-z]*|Segment[A-Za-z]*|FBSDK[A-Za-z]*|FBAudienceNetwork|AdMob|AppLovin[A-Za-z]*|OneSignal[A-Za-z]*|Datadog[A-Za-z]*|NewRelic[A-Za-z]*'
hits=$(swift_files | xargs -r grep -nE "^\s*(@[A-Za-z_]+(\([A-Za-z]+\))?\s+)*import\s+(class |struct |enum |func |protocol )?($deny)\b" || true)
hits+=$(git ls-files --cached --others --exclude-standard -- '*Package.swift' '*.pbxproj' '*Package.resolved' | xargs -r grep -niE "($deny)" | grep -viE 'firebase-free|no-analytics' || true)
[ -z "$hits" ] || bad "G6 data-collecting SDK (deny-list):" "$hits"
# Pure targets import Foundation (and their own siblings) only.
hits=$(swift_files | grep -E '^(apps/fast/Kit/Sources/FastCore|apps/qr/Kit/Sources/QRCore|SevenKit/Sources/SevenKitCore)/' \
  | xargs -r grep -nE '^\s*(@[a-zA-Z]+\s+)*import\s' | grep -vE 'import\s+(Foundation|FastCore|QRCore|SevenKitCore)\s*$' || true)
[ -z "$hits" ] || bad "G6 pure target imports something other than Foundation:" "$hits"

# G6c: open-source libraries are welcome, but every one is pinned and credited in THIRD-PARTY.md
# with an allowed licence. Local path packages (SevenKit, QRKit) are ours and exempt.
licences='MIT|BSD-2-Clause|BSD-3-Clause|Apache-2\.0|MPL-2\.0|ISC|Zlib|Unicode|GPL-3\.0|LGPL-3\.0|GPL-3\.0-compatible'
deps=$(git ls-files --cached --others --exclude-standard -- '*Package.swift' | xargs -r grep -noE '\.package\(\s*(name:[^,]*,\s*)?url:[^)]*\)?' || true)
unpinned=$(printf '%s\n' "$deps" | grep -vE '(exact:|revision:|\.exact\(|\.revision\()' | grep -v '^$' || true)
[ -z "$unpinned" ] || bad "G6 package dependency not pinned to an exact version or revision:" "$unpinned"
pbx=$(git ls-files --cached --others --exclude-standard -- '*.pbxproj' || true)
if [ -n "$pbx" ] && grep -q 'XCRemoteSwiftPackageReference' $pbx; then
  hits=$(grep -nA4 'requirement = {' $pbx | grep -nE 'kind = ' | grep -vE 'kind = (exactVersion|revision);' || true)
  [ -z "$hits" ] || bad "G6 Xcode package not pinned to an exact version or revision:" "$hits"
  deps+=$'\n'$(grep -nE 'repositoryURL = ' $pbx || true)
fi
for url in $(printf '%s\n' "$deps" | grep -oE 'https?://[^"]+' | sed -E 's/\.git$//' | sort -u); do
  line=$(grep -F "$url" THIRD-PARTY.md 2>/dev/null | head -1)
  if [ -z "$line" ]; then bad "G6 dependency missing from THIRD-PARTY.md:" "$url"
  elif ! printf '%s' "$line" | grep -qE "\b($licences)\b"; then bad "G6 dependency licence not on the allowed list (THIRD-PARTY.md):" "$line"
  fi
done

# G7: user-facing text. String catalogs, plists and string literals in UI code.
ui_swift=$(swift_files | grep -E '^(apps/fast/Kit/Sources/FastUI|apps/fast/App|apps/fast/Widgets|apps/fast/Watch|apps/qr/Kit/Sources/QRUI|SevenKit/Sources/SevenKit|apps/qr/App|apps/qr/MakeExtension|apps/qr/CheckExtension)/' || true)
ui_text=$(git ls-files --cached --others --exclude-standard -- '*.xcstrings' '*.strings' 'apps/qr/*Info.plist' 'apps/qr/**/Info.plist' 'apps/qr/Config/*.plist' 'apps/fast/Config/*.plist' || true)
hits=$( { [ -z "$ui_swift" ] || echo "$ui_swift" | xargs grep -nP '"(?:[^"\\]|\\.)*\bsafe(ly|ty|r|st)?\b(?:[^"\\]|\\.)*"' -i; \
          [ -z "$ui_text" ] || echo "$ui_text" | xargs grep -nPi '\bsafe(ly|ty|r|st)?\b'; } 2>/dev/null || true)
[ -z "$hits" ] || bad "G7 the word \"safe\" in user-facing text:" "$hits"
# Hard-coded prices: $7, $7.00, "seven dollars", 7 USD… The $7&D mark is a name, not a price.
hits=$( { [ -z "$ui_swift" ] || echo "$ui_swift" | xargs grep -nP '"(?:[^"\\]|\\.)*(\$\s?\d+(?!&)|\d+[.,]\d\d\s?(USD|EUR|€)|seven dollars)(?:[^"\\]|\\.)*"' -i; \
          [ -z "$ui_text" ] || echo "$ui_text" | xargs grep -nPi '\$\s?\d+(?!&)|seven dollars'; } 2>/dev/null || true)
[ -z "$hits" ] || bad "G7 hard-coded price in user-facing text:" "$hits"

# Internal process documents (plans, build reports, reviews) never get tracked; they live in the private brand repo.
hits=$(git ls-files | grep -E '(^|/)(PLAN(-.*)?|BUILD-REPORT.*|REVIEW.*)\.md$' || true)
[ -z "$hits" ] || bad "internal process document tracked (move it to the private brand repo):" "$hits"

# Brand icons never live in this repo (TRADEMARKS.md): every app icon must be the generic one.
# Official builds get the real icon from SEVENS_BRAND_DIR on the build copy only (scripts/vm).
generic_icon() { case "$1" in
  qr) echo e3c19931272107b262037ab35e4b8bf61b8da859d2052824d842c053b6897fc6;;
  fast) echo 3b75033fce9f3dc592ed48bec5ab2657262005faa2f5bf69600f6e92f081e809;;
esac; }
hits=""
for icon in apps/*/Brand/Brand.xcassets/AppIcon.appiconset/AppIcon-1024.png; do
  [ -f "$icon" ] || continue
  a=${icon#apps/}; a=${a%%/*}; want=$(generic_icon "$a")
  if [ -z "$want" ]; then hits+="$icon (no generic hash pinned for $a)"$'\n'
  elif [ "$(sha256sum "$icon" | cut -d' ' -f1)" != "$want" ]; then hits+="$icon"$'\n'; fi
done
[ -z "$hits" ] || bad "app icon is not the generic one (brand assets stay in the private repo):" "$hits"

# ...and nothing tracked points at them by name (upstream data files are exempt).
hits=$(git grep -nwE 'PLAN|BUILD-REPORT|REVIEW' -- ':!.gitignore' ':!scripts/check-rules' ':!apps/qr/Kit/Sources/QRCore/Data/public_suffix_list.dat' || true)
[ -z "$hits" ] || bad "tracked file refers to an internal process document:" "$hits"

# The personal test-build unlock (SevenKit DevUnlock.swift) comes only from the private build
# helper's command line; no committed project, xcconfig, scheme or CI file may set it.
hits=$(git ls-files --cached --others --exclude-standard -- '*.pbxproj' '*.xcconfig' '*.xcscheme' '.github/*' '*Package.swift' | xargs -r grep -n 'SEVENS_DEV_UNLOCK' || true)
[ -z "$hits" ] || bad "SEVENS_DEV_UNLOCK set in a committed build file:" "$hits"

# Look (SPEC "Look", polish guide §3.2): ink tint and paper app-wide, under the contrast rules.
# The colors and the tint are set in SevenKit; app code uses Tokens and SevenKit's helpers.
# The iPhone apps only: Fast's Watch app and widgets aren't on the look yet.
look_swift=$(swift_files | grep -E '^(apps/fast/Kit/Sources/FastUI|apps/fast/App|apps/qr/Kit/Sources/QRUI|SevenKit/Sources/SevenKit|apps/qr/App|apps/qr/MakeExtension|apps/qr/CheckExtension)/' || true)
look() { [ -z "$look_swift" ] || echo "$look_swift" | grep -vE "$1" | xargs -r grep -nE "$2" || true; }
hits=$(look '^$' '(foregroundStyle|foregroundColor)\(\s*\.(secondary|tertiary)\b|Color\.(secondary|tertiary)\b|\?\s*\.secondary\b|:\s*\.secondary\b')
[ -z "$hits" ] || bad "system secondary/tertiary text color (3.25:1 on paper): use Tokens.muted:" "$hits"
hits=$(look '^SevenKit/Sources/SevenKit/SevenComponents\.swift$' '\.(borderedProminent|glassProminent)\b')
[ -z "$hits" ] || bad "filled button outside SevenKit (its label must be onInk/onRed): use .sevenProminentButton():" "$hits"
# .tint(nil) is allowed: it hands a control back its system colour (green switches, as in Alarm).
hits=$(look '^SevenKit/Sources/SevenKit/(SevenComponents|SevenLook)\.swift$' '\.tint\(' | grep -v '\.tint(nil)' || true)
[ -z "$hits" ] || bad "tint set outside SevenKit's look (toggles stay untinted):" "$hits"
hits=$(look '^$' 'Color\.(orange|red|green|blue)\b|(foregroundStyle|foregroundColor|tint|fill)\(\s*\.(orange|red|green|blue)\b|\?\s*\.(orange|red)\b|:\s*\.(orange|red)\b')
[ -z "$hits" ] || bad "system color for text or status: use Tokens.caution/danger (role: .destructive is fine):" "$hits"
hits=$(look '^$' 'Color\(\s*\.(secondarySystemBackground|systemBackground|systemGroupedBackground|secondarySystemGroupedBackground)\)')
[ -z "$hits" ] || bad "system background on our screens: use Tokens.paper (.sevenScreenBackground) or Tokens.card (.sevenCard):" "$hits"
hits=$(look '^SevenKit/Sources/SevenKit/(Tokens|SevenComponents)\.swift$' 'Tokens\.(red|onRed)\b')
[ -z "$hits" ] || bad "brand red outside the Unlock button:" "$hits"
hits=$(swift_files | grep -vE '^SevenKit/Sources/SevenKit/AboutSection\.swift$|^SevenKit/Tests/' \
  | xargs -r grep -nE 'SevenStamp|Image\("(SevenStamp|SevenWordmark)"\)' || true)
[ -z "$hits" ] || bad "stamp or wordmark outside AboutSection.swift:" "$hits"

# Type and spacing (polish guide §4, §3.3, §12.3): text uses SevenKit's roles, layout uses Tokens.Space.
hits=$(look '^SevenKit/Sources/SevenKit/SevenType\.swift$' '\.font\(|\.fontWeight\(|Font\.custom|\.system\(size:')
[ -z "$hits" ] || bad "font set directly: use .textRole(...) (or .glyph() for a status symbol):" "$hits"
hits=$(look '^$' '\.caption2\b|[wW]eight\(\s*\.(light|thin|ultraLight)\b')
[ -z "$hits" ] || bad "caption2 or a light weight (fails contrast, looks dated):" "$hits"
hits=$(look '^SevenKit/Sources/SevenKit/(Tokens|SevenType|SevenLook)\.swift$' '(spacing:\s*|padding\((\.[a-zA-Z]+,\s*)?)[0-9]*[1-9]|lineSpacing\(\s*[0-9]')
[ -z "$hits" ] || bad "literal spacing number: use Tokens.Space:" "$hits"
hits=$(look '^$' '\.shadow\(')
[ -z "$hits" ] || bad "shadow on our screens (depth comes from materials and card on paper):" "$hits"
# Typographic punctuation in English UI strings: …, not ...; no em dashes.
hits=$( { [ -z "$look_swift" ] || echo "$look_swift" | xargs grep -nP '(defaultValue:|seven\("[^"]*",|\bf\()\s*"(?:[^"\\]|\\.)*(\.\.\.|—|--|[A-Za-z]'"'"'[A-Za-z])(?:[^"\\]|\\.)*"'; } 2>/dev/null || true)
[ -z "$hits" ] || bad "UI string with ..., an em dash or a straight apostrophe: use …, a full stop or colon, and ’:" "$hits"

[ $fail = 0 ] && echo "check-rules: G6, G7, the look, type and spacing pass"
exit $fail
