#!/usr/bin/env python3
"""Refresh Alarm & Loops' English catalog keys without overwriting translations or plural entries.

AlarmUI: f("…") literals (Kit/Sources/AlarmUI/Words.swift). Widgets: plain SwiftUI literals.
App: AlarmKit and App Intents strings (LocalizedStringResource, read from the app's main bundle).
Interpolated strings and plurals are added to the catalogs by hand and kept here.
"""
import json
import pathlib
import re
root = pathlib.Path(__file__).resolve().parent.parent / 'apps/alarm'
literal = r'"((?:[^"\\]|\\[^(])*)"'
for sources, pattern, output in [
    ([root / 'Kit/Sources/AlarmUI'], r'\bf\(' + literal + r'\)', root / 'Kit/Sources/AlarmUI/Resources/Localizable.xcstrings'),
    ([root / 'Widgets'], r'(?:Text|Label|LocalizedStringKey|configurationDisplayName|description)\(' + literal, root / 'Widgets/Localizable.xcstrings'),
    ([root / 'Kit/Sources/AlarmUI', root / 'App'], r'(?:LocalizedStringResource = |AlarmButton\(text:\s*|@Parameter\(title:\s*)' + literal, root / 'App/Localizable.xcstrings'),
]:
    catalog = json.loads(output.read_text()) if output.exists() else {'sourceLanguage': 'en', 'strings': {}, 'version': '1.0'}
    for directory in sources:
        for source in sorted(directory.rglob('*.swift')):
            for match in re.findall(pattern, source.read_text()):
                key = json.loads('"' + match + '"')
                catalog['strings'].setdefault(key, {'localizations': {'en': {'stringUnit': {'state': 'translated', 'value': key}}}})
    catalog['strings'] = dict(sorted(catalog['strings'].items()))
    output.write_text(json.dumps(catalog, ensure_ascii=False, indent=2) + '\n')
